{
  "name": "pitwall",
  "version": "0.1.0",
  "private": true,
  "description": "Agent manager you shape to fit yourself: a Forkware app",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#sdk/server": "./src/sdk/server.ts",
    "#sdk/ui": "./src/ui/sdk.tsx",
    "#sdk/types": "./src/sdk/types.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "server": "node --disable-warning=ExperimentalWarning src/cli.ts --server",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@langchain/core": "^1.2.16",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint": "^1.1.6",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
